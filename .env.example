# ============================================================================
# GOCSA Platform — Environment Configuration (template)
# ----------------------------------------------------------------------------
# Copy to `.env` (local) or set in the platform/secrets store per environment.
# NEVER commit a real .env. All values here are safe placeholders.
#
# DEC-020: the platform is DOMAIN-AGNOSTIC. Every URL/domain/credential is read
# from here — nothing is hardcoded. Production domains are connected ONLY at the
# production cutover; dev/preview/staging use platform-provided URLs.
# ============================================================================

# --- Environment ------------------------------------------------------------
# development | preview | staging | production
APP_ENV=development
NODE_ENV=development

# --- Brand / tenant (multi-site; docs/10 §19, docs/13 §8) -------------------
NEXT_PUBLIC_BRAND=gocsa
NEXT_PUBLIC_SITE_ID=gocsa-community-care

# --- Provider selection (infrastructure-agnostic; DEC-021) ------------------
# Placeholder/local by default. Real adapters (Vercel/Cloudflare/self-host/managed)
# are swapped at DEPLOYMENT via these vars — no code change.
STORAGE_PROVIDER=local        # local | s3 | r2
EMAIL_PROVIDER=console        # console | smtp | resend | ses
ANALYTICS_PROVIDER=noop       # noop | plausible | ga4
SEARCH_PROVIDER=memory        # memory (dev) | postgres (FTS)
CACHE_PROVIDER=memory         # memory | redis
AUTH_SESSION_PROVIDER=memory  # memory | redis | database
DEPLOYMENT_PROVIDER=local     # local | vercel | cloudflare | node
STORAGE_LOCAL_DIR=.storage    # local storage adapter output dir

# --- Site domain / URLs -----------------------------------------------------
# Dev/preview/staging: platform URL. Production: client domain (set at cutover).
#   Community Care (prod): https://gocsacommunitycare.com.au
#   RGHA (future prod):    https://www.rgha.com.au
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- CMS (Payload) ----------------------------------------------------------
NEXT_PUBLIC_CMS_URL=http://localhost:3000
PAYLOAD_PUBLIC_SERVER_URL=http://localhost:3000
# 32+ char random secret. Generate per environment; store in secrets manager.
PAYLOAD_SECRET=replace-with-a-long-random-secret

# --- API --------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:3000/api

# --- Database (Postgres; docs/13) -------------------------------------------
DATABASE_URI=postgres://user:password@localhost:5432/gocsa

# --- Object storage / CDN (media binaries; docs/17) -------------------------
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Public CDN/asset origin used to build image URLs (never hardcoded).
NEXT_PUBLIC_ASSET_URL=http://localhost:3000

# --- Email (enquiry routing; docs/09 §16, J4) -------------------------------
# Domain auth (SPF/DKIM/DMARC) configured at production cutover.
EMAIL_DOMAIN=example.org
EMAIL_FROM="GOCSA Community Care <noreply@example.org>"
EMAIL_PROVIDER_API_KEY=
ENQUIRY_INBOX=enquiries@example.org
ENQUIRY_INBOX_EL=enquiries-el@example.org

# --- Analytics (privacy-respecting; docs/18) --------------------------------
NEXT_PUBLIC_ANALYTICS_ID=
NEXT_PUBLIC_ANALYTICS_DOMAIN=

# --- Sessions / cache (docs/14 §6) ------------------------------------------
REDIS_URL=

# --- Signed-action secrets --------------------------------------------------
PREVIEW_SECRET=replace-with-a-random-secret
REVALIDATE_SECRET=replace-with-a-random-secret

# --- Search (future semantic; docs/13 §4, docs/15) --------------------------
# Uses Postgres FTS by default — no extra config. pgvector/engine added later.

# ============================================================================
# Required at boot (validated by the typed env schema — Sprint 1):
#   APP_ENV, NEXT_PUBLIC_BRAND, NEXT_PUBLIC_SITE_ID, NEXT_PUBLIC_SITE_URL,
#   NEXT_PUBLIC_CMS_URL, NEXT_PUBLIC_API_URL, NEXT_PUBLIC_ASSET_URL,
#   PAYLOAD_SECRET, DATABASE_URI
# Missing/invalid values must fail fast — no silent misconfiguration.
# ============================================================================
