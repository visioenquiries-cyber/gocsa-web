{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "globalEnv": [
    "APP_ENV",
    "ALLOW_SEED",
    "ANALYTICS_PROVIDER",
    "AUTH_SESSION_PROVIDER",
    "CACHE_PROVIDER",
    "DATABASE_URI",
    "DEPLOYMENT_PROVIDER",
    "EMAIL_DOMAIN",
    "EMAIL_FROM",
    "EMAIL_PROVIDER",
    "EMAIL_PROVIDER_API_KEY",
    "ENQUIRY_INBOX",
    "ENQUIRY_INBOX_EL",
    "NEXT_PUBLIC_ANALYTICS_DOMAIN",
    "NEXT_PUBLIC_ANALYTICS_ID",
    "NEXT_PUBLIC_API_URL",
    "NEXT_PUBLIC_ASSET_URL",
    "NEXT_PUBLIC_BRAND",
    "NEXT_PUBLIC_CMS_URL",
    "NEXT_PUBLIC_SITE_ID",
    "NEXT_PUBLIC_SITE_URL",
    "PAYLOAD_SECRET",
    "PREVIEW_SECRET",
    "REDIS_URL",
    "REVALIDATE_SECRET",
    "SEARCH_PROVIDER",
    "STORAGE_LOCAL_DIR",
    "STORAGE_PROVIDER",
    "VERCEL",
    "VERCEL_ENV",
    "VERCEL_URL"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**", "storybook-static/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    }
  }
}
